# systemd unit for the MasterBus -> Signal K bridge.
#
# Install:
#   sudo cp masterbus-signalk /usr/local/bin/
#   sudo cp masterbus-signalk.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now masterbus-signalk
#
# MasterBus transport configuration:
#   /etc/default/masterbus/config.ini
#
# Signal K field configuration:
#   /etc/default/masterbus-signalk/masterbus-signalk-fields.toml
#
# Default TCP listen address:
#   0.0.0.0:3009

[Unit]
Description=Mastervolt MasterBus to Signal K bridge
Documentation=https://github.com/pirateyachty/masterbus
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
SyslogIdentifier=masterbus-signalk

Environment=LISTEN=0.0.0.0:3009
EnvironmentFile=-/etc/default/masterbus-signalk/config

WorkingDirectory=/etc/default/masterbus-signalk
ExecStart=/usr/local/bin/masterbus-signalk ${LISTEN}

Restart=on-failure
RestartSec=5

StateDirectory=masterbus

[Install]
WantedBy=multi-user.target
